APP_NAME="Banking System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
API_VERSION=1.0.0

# Local builds use these defaults. Production can select versioned or
# digest-pinned images published by the release workflow.
APP_IMAGE=banking-system-app:local
WEB_IMAGE=banking-system-web:local

RATE_LIMIT_LOGIN_PER_MINUTE=6
RATE_LIMIT_LOGIN_IP_PER_MINUTE=30
RATE_LIMIT_CUSTOMER_PER_MINUTE=120
RATE_LIMIT_MONEY_MOVEMENT_PER_MINUTE=20
RATE_LIMIT_OPERATOR_PER_MINUTE=60
RATE_LIMIT_REPORTING_PER_MINUTE=30

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info
OBSERVABILITY_REQUEST_LOGS=true
OBSERVABILITY_EXCLUDE_LIVENESS_LOGS=true

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=banking
DB_USERNAME=banking
DB_PASSWORD=local-development-password

# The bundled PostgreSQL container uses these values when it creates the
# local production-like database for the first time.
POSTGRES_DB=banking
POSTGRES_USER=banking
POSTGRES_PASSWORD=local-development-password

# Production can replace these with narrowly scoped maintenance credentials.
BACKUP_POSTGRES_USER=banking
BACKUP_POSTGRES_PASSWORD=local-development-password
RESTORE_POSTGRES_USER=banking
RESTORE_POSTGRES_PASSWORD=local-development-password

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

MAIL_MAILER=log
MAIL_FROM_ADDRESS=banking@example.com
MAIL_FROM_NAME="Banking System"

CUSTOMER_PORTAL_URL=http://127.0.0.1:5173
OPERATIONS_PORTAL_URL=http://127.0.0.1:5174

SANCTUM_TOKEN_EXPIRATION=1440
PRIVILEGED_ACCESS_MINUTES=15
HIGH_VALUE_TRANSFER_THRESHOLD_MINOR_UNITS=1000000
HIGH_VALUE_TRANSFER_APPROVAL_MINUTES=5
RATE_LIMIT_PRIVILEGED_AUTH_PER_MINUTE=5
KYC_DOCUMENT_FINGERPRINT_KEY=

# These NGN IDs match the local demo seeder. Replace them for a real deployment.
BANKING_NGN_DEPOSIT_LEDGER_ID=40000000-0000-4000-8000-000000000003
BANKING_USD_DEPOSIT_LEDGER_ID=
BANKING_GBP_DEPOSIT_LEDGER_ID=
BANKING_NGN_WITHDRAWAL_LEDGER_ID=40000000-0000-4000-8000-000000000004
BANKING_USD_WITHDRAWAL_LEDGER_ID=
BANKING_GBP_WITHDRAWAL_LEDGER_ID=
IDEMPOTENCY_RETENTION_HOURS=24

