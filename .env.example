APP_NAME="Banking System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
API_VERSION=1.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Per-user or per-login request budgets. Lower sensitive-operation limits help
# contain credential guessing, accidental client loops, and automated abuse.
RATE_LIMIT_LOGIN_PER_MINUTE=6
RATE_LIMIT_LOGIN_IP_PER_MINUTE=30
RATE_LIMIT_CUSTOMER_PER_MINUTE=120
RATE_LIMIT_MONEY_MOVEMENT_PER_MINUTE=20
RATE_LIMIT_OPERATOR_PER_MINUTE=60
RATE_LIMIT_REPORTING_PER_MINUTE=30

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

OBSERVABILITY_REQUEST_LOGS=true
OBSERVABILITY_EXCLUDE_LIVENESS_LOGS=true

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_VERIFICATION_URL="${APP_URL}/verify-email"
FRONTEND_PASSWORD_RESET_URL="${APP_URL}/reset-password"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Internal settlement ledger UUIDs used only by trusted transaction endpoints.
BANKING_NGN_DEPOSIT_LEDGER_ID=
BANKING_USD_DEPOSIT_LEDGER_ID=
BANKING_GBP_DEPOSIT_LEDGER_ID=
BANKING_NGN_WITHDRAWAL_LEDGER_ID=
BANKING_USD_WITHDRAWAL_LEDGER_ID=
BANKING_GBP_WITHDRAWAL_LEDGER_ID=
